"""
Módulo: .env.example
Descripción: Archivo de ejemplo de variables de entorno.
Instrucciones: Copiar a .env y completar con valores reales.

cp .env.example .env
"""

# ===========================
# BVL API CONFIGURATION
# ===========================

# URL base de la API de BVL
BVL_API_BASE_URL=https://api.bvl.com.pe/v1

# Clave de API de BVL (obtener de https://developers.bvl.com.pe)
BVL_API_KEY=your_api_key_here

# Timeout para requests a la API (en segundos)
BVL_API_TIMEOUT=30

# Número de reintentos si la API falla
BVL_API_RETRIES=3

# ===========================
# LOGGING CONFIGURATION
# ===========================

# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===========================
# CACHE CONFIGURATION
# ===========================

# Habilitar caché de datos
ENABLE_CACHE=True

# Tiempo de vida del caché en segundos (1 hora = 3600)
CACHE_TTL_SECONDS=3600

# ===========================
# DEBUG MODE
# ===========================

# Habilitar modo debug (más verboso)
DEBUG_MODE=False

# Habilitar logging verbose
VERBOSE_LOGGING=False
